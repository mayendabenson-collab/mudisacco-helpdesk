{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'new' ? 'Create Employee' : 'Edit Employee' }} | {{ app_name }}{% endblock %}
{% block page_heading %}{{ mode == 'new' ? 'Create Employee' : 'Edit Employee' }}{% endblock %}

{% block topbar_actions %}
    {% include 'components/_button_link.html.twig' with { href: path('admin_staff_index'), label: 'Back to staff', variant: 'secondary' } only %}
{% endblock %}

{% block body %}
    <section class="form-panel">
        {% if errors is not empty %}
            <div class="alert alert--error">
                {% for error in errors %}<div>{{ error }}</div>{% endfor %}
            </div>
        {% endif %}

        {% if mode == 'new' %}
            <div class="info-callout" style="margin-bottom: var(--sp-5)">
                <div class="info-callout__icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <div>
                    <strong style="font-size:13px">About employee roles</strong>
                    <div style="margin-top: var(--sp-2); font-size:13px; display:grid; gap: var(--sp-1)">
                        <div><strong>Staff</strong> — Answer member calls, create and resolve tickets</div>
                        <div><strong>Supervisor</strong> — Manage team, handle escalations, review staff performance</div>
                        <div><strong>Administrator</strong> — System configuration and full management access</div>
                    </div>
                </div>
            </div>
        {% endif %}

        <form class="stack-form" method="post" action="{{ mode == 'new' ? path('admin_staff_new') : path('admin_staff_edit', { id: employee.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token(mode == 'new' ? 'staff_create' : 'staff_edit_' ~ employee.id) }}">

            <label class="form-field">
                <span>Full name</span>
                <input class="input" name="full_name" required value="{{ app.request.request.get('full_name') ?: employee.fullName }}">
            </label>

            <label class="form-field">
                <span>Work email</span>
                <input class="input" name="email" type="email" required value="{{ app.request.request.get('email') ?: employee.email }}">
            </label>

            <label class="form-field">
                <span>Role</span>
                <select class="input" name="role" required id="role-select">
                    {% set selectedRole = app.request.request.get('role') ?: (employee.roles|filter(role => role != 'ROLE_USER')|first) %}
                    <option value="">Select role</option>
                    {% for role in roles %}
                        <option value="{{ role.code }}"{% if selectedRole == role.code %} selected{% endif %}>{{ role.name }}</option>
                    {% endfor %}
                </select>
                <small class="muted" id="role-description" style="display: block; margin-top: 0.5rem;">
                    Select a role to see responsibilities
                </small>
            </label>

            <label class="form-field">
                <span>Department</span>
                <select class="input" name="department">
                    {% set selectedDepartment = app.request.request.get('department') ?: (employee.department ? employee.department.id : '') %}
                    <option value="">No department</option>
                    {% for department in departments %}
                        <option value="{{ department.id }}"{% if selectedDepartment == department.id %} selected{% endif %}>{{ department.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <div class="info-callout" style="margin-top: var(--sp-5); margin-bottom: var(--sp-5); display:block; padding: var(--sp-5);">
                <h4 style="margin: 0 0 var(--sp-2) 0; display:flex; align-items:center; gap:8px; font-size:14px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Staff Permissions
                </h4>
                <p style="margin: 0 0 var(--sp-4) 0; font-size:13px; color: var(--color-muted)">
                    Choose what this employee can do in the system.
                    Default permissions are set by role — you can adjust them here.
                </p>

                {% set permissionsByCategory = {} %}
                {% for permission in allPermissions %}
                    {% set category = permission.category() %}
                    {% if permissionsByCategory[category] is not defined %}
                        {% set permissionsByCategory = permissionsByCategory|merge({ (category): [] }) %}
                    {% endif %}
                    {% set permissionsByCategory = permissionsByCategory|merge({ (category): permissionsByCategory[category]|merge([permission]) }) %}
                {% endfor %}

                {% for category, permissions in permissionsByCategory %}
                    <div style="margin-bottom: 1.5rem;">
                        <h5 style="margin: 0 0 0.75rem 0; font-size: 0.95rem; color: #333;">{{ category }}</h5>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.75rem;">
                            {% for permission in permissions %}
                                <label class="checkbox-field" style="margin: 0; display: flex; align-items: flex-start;">
                                    <input 
                                        type="checkbox" 
                                        name="permission_{{ permission.value }}" 
                                        value="1"
                                        {% if permission.value in employee.staffPermissions %} checked{% endif %}
                                        style="margin-top: 2px; margin-right: 0.5rem; flex-shrink: 0;"
                                    >
                                    <span style="flex: 1;">
                                        <strong>{{ permission.label() }}</strong><br>
                                        <small style="color: #666; display: block; margin-top: 0.2rem;">{{ permission.description() }}</small>
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}

                <div style="margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid var(--color-line)">
                    <button type="button" class="button button--secondary" onclick="setDefaultPermissions()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.3"/></svg>
                        Reset to default permissions
                    </button>
                    <p class="muted" style="margin: var(--sp-2) 0 0">Resets checkboxes to the standard set for the selected role.</p>
                </div>
            </div>

            {% if mode == 'new' %}
                <p class="muted">A one-time setup link will be generated after creation. No temporary password will be displayed or stored.</p>
            {% elseif employee.passwordChangeRequired %}
                <p class="muted">Password setup is still required for this account.</p>
            {% endif %}

            <label class="checkbox-field">
                <input type="checkbox" name="active" value="1"{% if employee.active %} checked{% endif %}>
                <span>Account active</span>
            </label>

            <button class="button button--primary" type="submit">{{ mode == 'new' ? 'Create employee' : 'Save changes' }}</button>
        </form>

        
    </section>

    <script>
    // Permission sets for each role
    const defaultPermissions = {
        'ROLE_STAFF': [
            'create_tickets',
            'resolve_tickets',
            'view_member_history'
        ],
        'ROLE_SUPERVISOR': [
            'create_tickets',
            'resolve_tickets',
            'close_tickets',
            'assign_tickets',
            'reassign_tickets',
            'escalate_tickets',
            'view_all_department_tickets',
            'view_member_history',
            'view_reports',
            'edit_ticket_priority',
            'edit_ticket_category'
        ],
        'ROLE_ADMIN': [
            'create_tickets',
            'resolve_tickets',
            'close_tickets',
            'assign_tickets',
            'reassign_tickets',
            'escalate_tickets',
            'view_all_department_tickets',
            'view_member_history',
            'view_reports',
            'view_audit_log',
            'edit_ticket_priority',
            'edit_ticket_category'
        ]
    };

    document.getElementById('role-select').addEventListener('change', function() {
        const roleDescriptions = {
            'ROLE_STAFF': 'Creates and resolves tickets. Handles member calls and manages issues.',
            'ROLE_SUPERVISOR': 'Oversees team performance. Sees all department tickets and handles escalations.',
            'ROLE_ADMIN': 'System administration. Creates accounts, configures rules, and manages settings.',
        };

        const description = roleDescriptions[this.value] || 'Select a role to see responsibilities';
        document.getElementById('role-description').textContent = description;
    });
    
    // Show description on page load if role is already selected
    if (document.getElementById('role-select').value) {
        document.getElementById('role-select').dispatchEvent(new Event('change'));
    }

    function setDefaultPermissions() {
        const roleSelect = document.getElementById('role-select');
        const selectedRole = roleSelect.value;
        
        if (!selectedRole || !defaultPermissions[selectedRole]) {
            alert('Please select a role first');
            return;
        }

        const defaults = defaultPermissions[selectedRole];
        
        // Uncheck all
        document.querySelectorAll('input[name^="permission_"]').forEach(checkbox => {
            checkbox.checked = false;
        });

        // Check only the defaults for this role
        defaults.forEach(permissionValue => {
            const checkbox = document.querySelector('input[name="permission_' + permissionValue + '"]');
            if (checkbox) {
                checkbox.checked = true;
            }
        });
    }
    </script>
{% endblock %}