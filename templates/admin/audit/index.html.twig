{% extends 'base.html.twig' %}

{% block title %}Audit Log | {{ app_name }}{% endblock %}
{% block page_heading %}Audit Log{% endblock %}

{% block body %}
    <section class="page-section">
        <form class="filter-bar" method="get" action="{{ path('admin_audit_index') }}">
            <label class="form-field compact-field">
                <span>Action</span>
                <select class="input" name="action">
                    <option value="">All actions</option>
                    {% for action in actions %}
                        <option value="{{ action }}"{% if selectedAction == action %} selected{% endif %}>{{ action }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Entity</span>
                <select class="input" name="entity_type">
                    <option value="">All entities</option>
                    {% for entityType in entityTypes %}
                        <option value="{{ entityType }}"{% if selectedEntityType == entityType %} selected{% endif %}>{{ entityType }}</option>
                    {% endfor %}
                </select>
            </label>
            <button class="button button--secondary" type="submit">Filter</button>
        </form>

        <div class="table-wrap">
            <table class="data-table audit-table">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>IP address</th>
                        <th>Context</th>
                    </tr>
                </thead>
                <tbody>
                {% for log in auditLogs %}
                    <tr>
                        <td>{{ log.createdAt|date('M j, Y H:i:s') }}</td>
                        <td>{{ log.actor ? log.actor.fullName : 'System' }}<br><span class="muted">{{ log.actor ? log.actor.email : '' }}</span></td>
                        <td><code>{{ log.action }}</code></td>
                        <td>{{ log.entityType }}{% if log.entityId %}<br><span class="muted">{{ log.entityId }}</span>{% endif %}</td>
                        <td>{{ log.ipAddress ?: 'Not captured' }}</td>
                        <td>
                            {% if log.context is not empty %}
                                <dl class="context-list">
                                    {% for key, value in log.context %}
                                        <div>
                                            <dt>{{ key|replace({'_': ' '})|title }}</dt>
                                            <dd>{{ value is iterable ? value|json_encode : value }}</dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            {% else %}
                                <span class="muted">No context</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    {% include 'components/_table_empty.html.twig' with { colspan: 6, title: 'No audit records', message: 'Ticket and staff actions will appear here after users perform them.' } only %}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
