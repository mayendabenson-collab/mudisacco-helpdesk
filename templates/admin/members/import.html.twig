{% extends 'base.html.twig' %}

{% block title %}Import Members | Admin | {{ app_name }}{% endblock %}
{% block page_heading %}Bulk Member Import{% endblock %}

{% block topbar_actions %}
    {% include 'components/_button_link.html.twig' with { href: path('admin_members_index'), label: 'Back to members', variant: 'secondary' } only %}
{% endblock %}

{% block body %}
<section class="page-section">
    {% if errors %}
        <div class="alert alert--error" style="margin-bottom: var(--sp-4);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:2px">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <div>
                <strong>Errors occurred during upload:</strong>
                <ul style="margin: 4px 0 0 16px; padding: 0;">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    {% if result %}
        <section class="panel-section" style="max-width: 800px;">
            <p class="section-kicker">Operation summary</p>
            <h2>Import Results</h2>

            <div class="metrics-grid" style="margin: var(--sp-4) 0;">
                <div class="metric">
                    <div class="metric-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <span>Created</span>
                    <strong>{{ result.created }}</strong>
                </div>

                <div class="metric">
                    <div class="metric-icon metric-icon--info">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                        </svg>
                    </div>
                    <span>Updated</span>
                    <strong>{{ result.updated }}</strong>
                </div>

                <div class="metric">
                    <div class="metric-icon metric-icon--warn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                        </svg>
                    </div>
                    <span>Skipped</span>
                    <strong>{{ result.skipped }}</strong>
                </div>

                <div class="metric">
                    <div class="metric-icon metric-icon--danger">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                    </div>
                    <span>Errors</span>
                    <strong>{{ result.error_count }}</strong>
                </div>
            </div>

            {% if result.errors %}
                <div class="alert alert--error" style="margin-top: var(--sp-4);">
                    <strong>Row processing errors:</strong>
                    <ul style="margin: 6px 0 0 16px; padding: 0; max-height: 240px; overflow-y: auto;">
                        {% for error in result.errors %}
                            <li><code>{{ error }}</code></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="form-actions" style="margin-top: var(--sp-5);">
                <a href="{{ path('admin_members_import') }}" class="button button--primary">Import Another File</a>
                <a href="{{ path('admin_members_index') }}" class="button button--secondary">View All Members</a>
            </div>
        </section>
    {% else %}
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: var(--sp-5); align-items: start;">
            <section class="panel-section">
                <p class="section-kicker">CSV Upload</p>
                <h2>Select Member Spreadsheet</h2>

                <form method="POST" enctype="multipart/form-data" class="stack-form" style="margin-top: var(--sp-4);">
                    <input type="hidden" name="_token" value="{{ csrf_token('member_import') }}">

                    <label class="form-field">
                        <span>CSV File *</span>
                        <input type="file" id="csv_file" name="csv_file" class="input" accept=".csv" required>
                        <small class="muted">File must be UTF-8 encoded CSV format.</small>
                    </label>

                    <label class="checkbox-field" style="margin-top: var(--sp-2);">
                        <input type="checkbox" id="skip_existing" name="skip_existing" value="1">
                        <span>Skip existing members if member number already exists</span>
                    </label>

                    <div class="form-actions" style="margin-top: var(--sp-5);">
                        <button type="submit" class="button button--primary">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                            Start Import
                        </button>
                        <a href="{{ path('admin_members_index') }}" class="button button--secondary">Cancel</a>
                    </div>
                </form>
            </section>

            <aside class="panel-section">
                <p class="section-kicker">Format Specifications</p>
                <h3>Required Columns</h3>
                <p class="muted" style="font-size: 13px;">Your CSV must have these headers in row 1:</p>
                <ol style="font-size: 13px; padding-left: 18px; line-height: 1.8; color: var(--color-ink);">
                    <li><code>member_number</code> (Required)</li>
                    <li><code>display_name</code> (Required)</li>
                    <li><code>primary_phone</code></li>
                    <li><code>email</code></li>
                    <li><code>status</code> (ACTIVE / INACTIVE)</li>
                    <li><code>branch_code</code></li>
                </ol>

                <div style="margin-top: var(--sp-4); padding: var(--sp-3); background: var(--color-surface-2); border: 1px solid var(--color-line); border-radius: var(--radius-md);">
                    <strong style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted);">Branch Codes:</strong>
                    <div class="muted" style="font-size: 12px; margin-top: 4px; line-height: 1.6;">
                        BLANTYRE_MAIN, LILONGWE_KANENGO, MZUZU, ZOMBA, KASINTHULA_CHIKWAWA, NSANJE, MULANJE_SATELLITE
                    </div>
                </div>
            </aside>
        </div>
    {% endif %}
</section>
{% endblock %}
