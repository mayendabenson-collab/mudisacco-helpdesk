{% extends 'base.html.twig' %}

{% block title %}Members | Admin | {{ app_name }}{% endblock %}
{% block page_heading %}Member Management{% endblock %}

{% block topbar_actions %}
    <div style="display:flex; gap: var(--sp-2);">
        {% include 'components/_button_link.html.twig' with { href: path('admin_members_import'), label: 'Bulk Import', variant: 'secondary' } only %}
        {% include 'components/_button_link.html.twig' with { href: path('admin_members_new'), label: '+ Add Member', variant: 'primary' } only %}
    </div>
{% endblock %}

{% block body %}
<section class="page-section">
    {# ── Search & Filters ────────────────────────────────────── #}
    <form class="filter-bar filter-bar--wide" method="get" action="{{ path('admin_members_index') }}">
        <label class="form-field compact-field" style="flex:1;">
            <span>Search members</span>
            <input class="input" type="text" name="search" placeholder="Search by member number, name, phone or email..." value="{{ search }}">
        </label>
        <button class="button button--secondary" type="submit">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            Search
        </button>
        {% if search %}
            <a class="button button--ghost" href="{{ path('admin_members_index') }}">Clear</a>
        {% endif %}
    </form>

    {# ── Members Table ───────────────────────────────────────── #}
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>
                        <span class="th-icon">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
                        </span>
                        Member No
                    </th>
                    <th>
                        <span class="th-icon">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                        </span>
                        Customer Name
                    </th>
                    <th>Contact</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for member in members %}
                    {% set initials = member.displayName|split(' ')|map(w => w|slice(0, 1)|upper)|join('')|slice(0, 2) %}
                    {% set avatarClasses = ['', 'avatar--green', 'avatar--purple', 'avatar--amber', 'avatar--rose', 'avatar--slate'] %}
                    {% set avatarClass = avatarClasses[member.displayName|length % 5] %}
                    <tr>
                        <td>
                            <code>{{ member.memberNumber }}</code>
                        </td>
                        <td>
                            <div class="member-cell">
                                <span class="avatar avatar--sm {{ avatarClass }}">{{ initials }}</span>
                                <span class="member-cell__name">{{ member.displayName }}</span>
                            </div>
                        </td>
                        <td>
                            <div>{{ member.email ?? '—' }}</div>
                            {% if member.primaryPhone %}
                                <div class="muted" style="font-size:12px;">{{ member.primaryPhone }}</div>
                            {% endif %}
                        </td>
                        <td>
                            {% if member.branch %}
                                <span class="muted">{{ member.branch.name }}</span>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set isActive = member.status.value == 'ACTIVE' %}
                            <span class="badge badge--{{ isActive ? 'success' : 'warning' }}">
                                <span class="sdot sdot--{{ isActive ? 'success' : 'warning' }}"></span>
                                {{ member.status.value }}
                            </span>
                        </td>
                        <td style="text-align:right;">
                            <div style="display:inline-flex; gap: var(--sp-2); align-items:center;">
                                <a class="button button--secondary button--sm" href="{{ path('admin_members_edit', {id: member.id}) }}">Edit</a>
                                <form method="POST" action="{{ path('admin_members_delete', {id: member.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete member {{ member.displayName|e('js') }}?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('member_delete_' ~ member.id.toRfc4122()) }}">
                                    <button type="submit" class="button button--danger button--sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    {% include 'components/_table_empty.html.twig' with { colspan: 6, title: 'No members found', message: search ? 'Try a different search term.' : 'Create your first member or import from CSV.' } only %}
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# ── Pagination ──────────────────────────────────────────── #}
    {% set totalPages = (total / limit) | round(0, 'ceil') %}
    {% if totalPages > 1 %}
        <div class="pagination-row">
            <span class="muted">Showing {{ ((page - 1) * limit) + 1 }} to {{ (page * limit) < total ? (page * limit) : total }} of {{ total }} members</span>
            <div class="row-actions">
                {% if page > 1 %}
                    <a class="button button--secondary button--small" href="{{ path('admin_members_index', {page: page - 1, search: search}) }}">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Previous
                    </a>
                {% endif %}
                <span class="muted">Page {{ page }} of {{ totalPages }}</span>
                {% if page < totalPages %}
                    <a class="button button--secondary button--small" href="{{ path('admin_members_index', {page: page + 1, search: search}) }}">
                        Next
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
