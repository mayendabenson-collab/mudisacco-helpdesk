{% extends 'base.html.twig' %}

{% block title %}Set Password | {{ app_name }}{% endblock %}
{% block page_heading %}Set Password{% endblock %}

{% block body %}
    <section class="auth-layout">
        <form class="auth-form" method="post" action="{{ path('password_reset', { token: token }) }}">
            <div>
                <p class="section-kicker">Account security</p>
                <h2>Create a new password</h2>
            </div>

            {% if errors is not empty %}
                <div class="alert alert--error">
                    {% for error in errors %}<div>{{ error }}</div>{% endfor %}
                </div>
            {% endif %}

            <input type="hidden" name="_token" value="{{ csrf_token('password_reset_' ~ token) }}">
            {% include 'components/_form_field.html.twig' with { label: 'New password', name: 'password', type: 'password', required: true } only %}
            {% include 'components/_form_field.html.twig' with { label: 'Confirm password', name: 'confirm_password', type: 'password', required: true } only %}
            <p class="muted">Use at least 12 characters. Avoid passwords you use elsewhere.</p>
            <button class="button button--primary" type="submit">Set password</button>
        </form>
    </section>
{% endblock %}