{% extends 'base.html.twig' %}

{% block title %}Reset Password | {{ app_name }}{% endblock %}
{% block page_heading %}Reset Password{% endblock %}

{% block body %}
    <section class="auth-layout">
        <form class="auth-form" method="post" action="{{ path('password_request') }}">
            <div>
                <p class="section-kicker">Account security</p>
                <h2>Request a secure password link</h2>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('password_request') }}">
            {% include 'components/_form_field.html.twig' with { label: 'Email address', name: 'email', type: 'email', required: true } only %}
            <button class="button button--primary" type="submit">Request link</button>
        </form>
    </section>
{% endblock %}