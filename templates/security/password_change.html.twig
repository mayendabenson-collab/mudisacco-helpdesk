{% extends 'base.html.twig' %}

{% block title %}Change Password | {{ app_name }}{% endblock %}
{% block page_heading %}Change Your Password{% endblock %}

{% block body %}
<div class="form-page">
    <section class="page-section panel-section form-panel">
        <p class="section-kicker">Security</p>
        <h2>Password Change Required</h2>
        <p class="text-muted" style="margin-bottom:1.5rem;">
            Your account requires a password change before you can continue.
            Please set a strong password of at least 12 characters.
        </p>

        {% for error in errors %}
            <div class="alert alert--error">{{ error }}</div>
        {% endfor %}

        <form class="stack-form" method="post" action="{{ path('password_change') }}" autocomplete="off">
            <input type="hidden" name="_token" value="{{ csrf_token('password_change') }}">

            <label class="form-field" for="current_password">
                <span>Current password</span>
                <input
                    class="input"
                    id="current_password"
                    type="password"
                    name="current_password"
                    required
                    autocomplete="current-password"
                >
            </label>

            <label class="form-field" for="password">
                <span>New password <small class="muted">(minimum 12 characters)</small></span>
                <input
                    class="input"
                    id="password"
                    type="password"
                    name="password"
                    minlength="12"
                    required
                    autocomplete="new-password"
                >
            </label>

            <label class="form-field" for="confirm_password">
                <span>Confirm new password</span>
                <input
                    class="input"
                    id="confirm_password"
                    type="password"
                    name="confirm_password"
                    minlength="12"
                    required
                    autocomplete="new-password"
                >
            </label>

            <div class="form-actions">
                <button class="button button--primary" type="submit">Set new password</button>
                <a class="button button--secondary" href="{{ path('app_logout') }}">Sign out instead</a>
            </div>
        </form>
    </section>
</div>
{% endblock %}
